# Railway Environment Variables Template for auth.xcity.ai Integration
# Copy these variables to your Railway project's Variables section

# ============================
# OpenID Connect Configuration
# ============================

# Core OIDC Settings (REQUIRED - all 5 must be set for OpenID to activate)
OPENID_CLIENT_ID=YOUR_CLIENT_ID_FROM_AUTH_XCITY_AI
OPENID_CLIENT_SECRET=YOUR_CLIENT_SECRET_FROM_AUTH_XCITY_AI
OPENID_ISSUER=https://auth.xcity.ai
# Temporary migration bridge. Remove after all stored Chat issuers have migrated.
OPENID_LEGACY_ISSUERS=https://auth.xcity.one
OPENID_SESSION_SECRET=GENERATE_RANDOM_32_CHAR_STRING
OPENID_SCOPE=openid profile email
OPENID_CALLBACK_URL=/oauth/openid/callback

# Auto-redirect to auth.xcity.ai
OPENID_AUTO_REDIRECT=true

# Button Customization
OPENID_BUTTON_LABEL=Login with Xcity
OPENID_IMAGE_URL=/logo.png

# Logout Synchronization
OPENID_USE_END_SESSION_ENDPOINT=true
OPENID_POST_LOGOUT_REDIRECT_URI=https://chat.xcity.ai/login

# ============================
# Domain Configuration
# ============================
DOMAIN_CLIENT=https://chat.xcity.ai
DOMAIN_SERVER=https://chat.xcity.ai

# ============================
# XCity AI / LiteLLM Integration
# ============================
# API key for accessing tokenhub.xcity.one (LiteLLM gateway)
# This provides access to all AI models (Tencent, OpenAI, Anthropic, Google, etc.)
LITELLM_API_KEY=YOUR_LITELLM_API_KEY

# ----------------------------
# In-chat Image Generation (via LiteLLM)
# ----------------------------
# Enables the built-in "OpenAI Image Tools" agent tool (image_gen_oai +
# image_edit_oai). LibreChat calls POST {BASEURL}/images/generations, so we
# point it straight at the LiteLLM gateway and reuse the same virtual key.
# The tool is auto-enabled whenever IMAGE_GEN_OAI_API_KEY is set; agents can
# then generate/edit images inline. Model must be an image model registered in
# LiteLLM. For ByteDance/Dreamina IMAGE generation use a *seedream* id
# (e.g. seedream-5-0-260128) — seedance ids are VIDEO models, not image.
# Single-model tool: this replaces gpt-image-1 here.
# Billing: when XCT_KEY_EXCHANGE_ENABLED=true, the image/video tools swap this
# shared key for the signed-in user's own vkey at request time (per-plan budget);
# this value is only the fail-safe fallback.
IMAGE_GEN_OAI_API_KEY=${LITELLM_API_KEY}
IMAGE_GEN_OAI_BASEURL=https://tokenhub.xcity.one/v1
IMAGE_GEN_OAI_MODEL=gpt-image-1

# ----------------------------
# In-chat Video Generation (native "video_gen" tool)
# ----------------------------
# The fork ships a native agent tool (video_gen) that calls the gateway video
# API (create -> poll -> retrieve) and returns the clip as a video attachment.
# Auto-enabled for agents whenever VIDEO_GEN_API_KEY is set; everything flows
# through tokenhub so per-user budgets/permissions still apply.
# VERIFIED: dreamina-seedance-2-0-260128 is a BytePlus (ByteDance Ark) video
# model exposed via LiteLLM's OpenAI-compatible video API — POST /v1/videos ->
# poll GET /v1/videos/{id} -> the completed job carries output_url. Params are
# OpenAI-standard (prompt, seconds, size, input_reference).
VIDEO_GEN_API_KEY=${LITELLM_API_KEY}
VIDEO_GEN_BASEURL=https://tokenhub.xcity.one/v1
VIDEO_GEN_MODEL=dreamina-seedance-2-0-260128
# VIDEO_GEN_CREATE_PATH=/videos
# VIDEO_GEN_POLL_INTERVAL_MS=3000
# VIDEO_GEN_MAX_WAIT_MS=300000
#
# Audio generation remains unwired (no native tool); expose xct-infra-fal
# /generate/audio as an Agent Action if needed.
# FAL_GATEWAY_URL=https://<your-fal-gateway>

# ----------------------------
# LiteLLM Hub integration (Agent Marketplace + Skills)
# ----------------------------
# Surface agents/skills hosted on the LiteLLM gateway inside xct-chat's
# Agent Marketplace and Skills board. Read-only, gated, and fail-safe: if a
# flag is off or the gateway errors, the local experience is unchanged.
# Requires LITELLM_API_KEY (above) for auth.
# LITELLM_BASEURL points at the proxy root (with or without /v1).
LITELLM_BASEURL=https://tokenhub.xcity.one
# LITELLM_AGENTS_ENABLED=true   # show LiteLLM /v1/agents in the marketplace
# LITELLM_SKILLS_ENABLED=true   # show LiteLLM /v1/xct-skills in the skills board
# LITELLM_PUBLISH_ENABLED=true  # let users publish agents to the marketplace
#   (needs AGENT_REGISTRY_ALLOW_USER_WRITES=true on the gateway and the XCT
#   key exchange below — publications are owned by the user's vkey identity)
#
# MCP servers are wired in librechat.yaml (mcpServers), NOT here — point each at
# https://tokenhub.xcity.one/<alias>/mcp with Authorization: Bearer ${LITELLM_API_KEY}.

# ----------------------------
# XCT per-user virtual-key exchange (FORK-CHANGES.md §1)
# ----------------------------
# When enabled, the 'XCity AI' endpoint swaps the shared LITELLM_API_KEY for
# the signed-in user's own LiteLLM virtual key (per-plan models / budget /
# RPM enforced by the gateway). Keys are exchanged from xct-wallet using the
# user's GoTrue uuid (OpenID sub) and cached for 60s. Fail-safe: any wallet
# error falls back to the shared key. Requires OpenID login (above) so users
# carry a GoTrue identity.
XCT_KEY_EXCHANGE_ENABLED=true
WALLET_BASE_URL=https://wallet.xcity.one
WALLET_SERVICE_TOKEN=YOUR_WALLET_SERVICE_TOKEN
# XCT_ENDPOINT_NAME=XCity AI    # only if the endpoint name in librechat.yaml changes

# ============================
# Authentication Method Control
# ============================
# Set to false to disable local email/password login (auth.xcity.ai only)
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false

# ============================
# How to Use This Template
# ============================
# 1. Register xct-chat at auth.xcity.ai admin panel
#    - Redirect URI: https://chat.xcity.ai/oauth/openid/callback
#    - Get CLIENT_ID and CLIENT_SECRET
#
# 2. Generate OPENID_SESSION_SECRET:
#    - Run: openssl rand -base64 32
#    - Or use any 32+ character random string
#
# 3. In Railway:
#    - Go to your project > xct-chat service > Variables tab
#    - Add each variable with actual values (replace YOUR_* placeholders)
#    - Click Deploy to restart with new configuration
#
# 4. Verify:
#    - Visit https://chat.xcity.ai (not logged in)
#    - Should auto-redirect to auth.xcity.ai
#    - Login and verify callback works
#    - Test logout synchronization
